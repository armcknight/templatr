#!/bin/sh
# Usage: store-secrets [--asc-key <.p8> --asc-key-id <id> --asc-issuer-id <id>]
#                      [--asc-admin-key <.p8> --asc-admin-key-id <id> --asc-admin-issuer-id <id>]
#                      [--fly-app <app>]... [--check <repository>]... [--dry-run]
#
# Stores the App Store Connect API keys and the Fly deploy tokens in the
# Keychain, under the item names that the apple-app and vapor-fly manifests
# give in their secrets' `source` fields. It is the terminal half of making
# them: Apple has no CLI or API that makes a team API key, so make each key on
# the App Store Connect website first and download its .p8 file.
#
#   --asc-key, --asc-key-id, --asc-issuer-id
#       The Uploads key (App Manager role): its .p8 file, its key ID and the
#       issuer ID. Stored as ASC_KEY_P8_BASE64 (the file, base64 encoded),
#       ASC_KEY_ID and ASC_ISSUER_ID.
#   --asc-admin-key, --asc-admin-key-id, --asc-admin-issuer-id
#       The same for the Admin key, which match uses to make certificates and
#       profiles. Stored as ASC_ADMIN_KEY_P8_BASE64, ASC_ADMIN_KEY_ID and
#       ASC_ADMIN_ISSUER_ID.
#   --fly-app <app>
#       Makes a deploy token for the Fly app with `fly tokens create deploy`,
#       and stores it as the app's FLY_API_TOKEN. Can be given more than one
#       time. `fly` must be logged in.
#   --check <repository>
#       At the end, runs `swift run templatr check` on the repository. Can be
#       given more than one time.
#   --dry-run
#       Prints the item that each value would go in, and stores nothing, makes
#       no token and runs no check.
#
# It also looks for MATCH_PASSWORD and MATCH_DEPLOY_KEY in the Keychain, and
# says how to add each one that is missing; it does not make them.
#
# A value is never printed, and never in a command's arguments, where `ps` can
# show it: it goes to `security -i` on standard input, as hexadecimal, as
# templatr itself stores Keychain items. Items are stored with -U, so running
# this again replaces the values.
#
# Exits 0 when everything was stored and nothing is missing, 1 when something
# failed or is missing, 2 for a usage error.

set -u

root=$(cd "$(dirname "$0")/.." && pwd)
components="$root/components"

usage() {
  sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

fail() {
  echo "store-secrets: $*" >&2
  exit 1
}

need_value() {
  [ $# -ge 2 ] && [ -n "$2" ] || { echo "store-secrets: $1 needs a value" >&2; usage; }
}

asc_key="" asc_key_id="" asc_issuer_id=""
admin_key="" admin_key_id="" admin_issuer_id=""
fly_apps="" checks="" dry_run=0

# The repositories are kept one to a line, so a path may have spaces.
newline='
'

while [ $# -gt 0 ]; do
  case "$1" in
    --asc-key) need_value "$@"; asc_key="$2"; shift 2 ;;
    --asc-key-id) need_value "$@"; asc_key_id="$2"; shift 2 ;;
    --asc-issuer-id) need_value "$@"; asc_issuer_id="$2"; shift 2 ;;
    --asc-admin-key) need_value "$@"; admin_key="$2"; shift 2 ;;
    --asc-admin-key-id) need_value "$@"; admin_key_id="$2"; shift 2 ;;
    --asc-admin-issuer-id) need_value "$@"; admin_issuer_id="$2"; shift 2 ;;
    --fly-app)
      need_value "$@"
      case "$2" in *[!a-z0-9-]*) echo "store-secrets: '$2' is not a Fly app name" >&2; exit 2 ;; esac
      fly_apps="$fly_apps $2"
      shift 2
      ;;
    --check) need_value "$@"; checks="$checks$2$newline"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage ;;
    *) echo "store-secrets: unknown option $1" >&2; usage ;;
  esac
done

# The source of the secret <name> in the component's manifest, such as
# keychain:templatr.asc.key-id.
source_of() {
  awk -v name="$2" '
    /^\[\[/ { in_secret = ($0 == "[[secrets]]"); found = 0 }
    in_secret && $0 ~ "^name = \"" name "\"$" { found = 1 }
    in_secret && found && /^source = "/ { sub(/^source = "/, ""); sub(/".*$/, ""); print; exit }
  ' "$components/$1/component.toml"
}

# The Keychain item that holds the secret <name> of the component, with
# {{inputs.fly_app}} filled with <app>. A generate: secret is kept in
# templatr.<name>, lowercased with dashes, as templatr keeps it.
item_of() {
  source=$(source_of "$1" "$2")
  case "$source" in
    keychain:*) item=${source#keychain:} ;;
    generate:*) item="templatr.$(printf '%s' "$2" | tr 'A-Z_' 'a-z-')" ;;
    *) fail "the $1 manifest has no Keychain source for the secret $2" ;;
  esac
  item=$(printf '%s' "$item" | sed "s/{{inputs.fly_app}}/${3:-}/g")
  case "$item" in
    *[!A-Za-z0-9._-]*|"") fail "the item name '$item' for $2 has characters this script does not quote" ;;
  esac
  printf '%s\n' "$item"
}

# Stores standard input in the Keychain item. The value goes to `security -i`
# as hexadecimal on standard input, so it is not in any process's arguments
# and may have new lines. `security -i` exits 0 even when its command fails,
# and then prints the error.
store() {
  if [ "$dry_run" -eq 1 ]; then
    echo "Would store $2 in the Keychain item $1."
    cat >/dev/null
    return 0
  fi
  hex=$(od -An -v -tx1 | tr -d ' \n')
  [ -n "$hex" ] || fail "the value for $1 is empty"
  if ! errors=$(printf 'add-generic-password -U -a templatr -s %s -X %s\n' "$1" "$hex" | security -i 2>&1 >/dev/null) ||
    [ -n "$errors" ]; then
    fail "could not store the Keychain item $1: $errors"
  fi
  echo "Stored $2 in the Keychain item $1."
}

# Checks the options of one API key, before anything is stored.
check_key() {
  label="$1" key="$2" key_id="$3" issuer_id="$4"
  [ -z "$key$key_id$issuer_id" ] && return 0
  [ -n "$key" ] && [ -n "$key_id" ] && [ -n "$issuer_id" ] ||
    { echo "store-secrets: the $label key needs its .p8 file, its key ID and its issuer ID" >&2; usage; }
  [ -r "$key" ] || fail "cannot read $key"
  grep -q 'BEGIN PRIVATE KEY' "$key" || fail "$key is not a .p8 private key"
}

check_key Uploads "$asc_key" "$asc_key_id" "$asc_issuer_id"
check_key Admin "$admin_key" "$admin_key_id" "$admin_issuer_id"

# Every item name first, so that a manifest problem stops the run before
# anything is stored.
uploads_id_item=$(item_of apple-app ASC_KEY_ID) || exit 1
uploads_issuer_item=$(item_of apple-app ASC_ISSUER_ID) || exit 1
uploads_p8_item=$(item_of apple-app ASC_KEY_P8_BASE64) || exit 1
admin_id_item=$(item_of apple-app ASC_ADMIN_KEY_ID) || exit 1
admin_issuer_item=$(item_of apple-app ASC_ADMIN_ISSUER_ID) || exit 1
admin_p8_item=$(item_of apple-app ASC_ADMIN_KEY_P8_BASE64) || exit 1
match_password_item=$(item_of apple-app MATCH_PASSWORD) || exit 1
match_key_item=$(item_of apple-app MATCH_DEPLOY_KEY) || exit 1
for app in $fly_apps; do
  item_of vapor-fly FLY_API_TOKEN "$app" >/dev/null || exit 1
done

if [ -n "$fly_apps" ] && [ "$dry_run" -eq 0 ]; then
  command -v fly >/dev/null || fail "flyctl is not installed: brew install flyctl"
  fly auth whoami >/dev/null 2>&1 || fail "fly is not logged in: run fly auth login"
fi

# The value comes from printf, a shell builtin, so it is in no process's
# arguments either. The .p8 file is base64 encoded on one line.
if [ -n "$asc_key" ]; then
  printf '%s' "$asc_key_id" | store "$uploads_id_item" "the Uploads key's ID"
  printf '%s' "$asc_issuer_id" | store "$uploads_issuer_item" "the Uploads key's issuer ID"
  base64 <"$asc_key" | tr -d '\n' | store "$uploads_p8_item" "the Uploads key's .p8 file, base64 encoded"
fi

if [ -n "$admin_key" ]; then
  printf '%s' "$admin_key_id" | store "$admin_id_item" "the Admin key's ID"
  printf '%s' "$admin_issuer_id" | store "$admin_issuer_item" "the Admin key's issuer ID"
  base64 <"$admin_key" | tr -d '\n' | store "$admin_p8_item" "the Admin key's .p8 file, base64 encoded"
fi

# The expiry is the manifest's rotateEvery of FLY_API_TOKEN, one year.
for app in $fly_apps; do
  item=$(item_of vapor-fly FLY_API_TOKEN "$app")
  if [ "$dry_run" -eq 1 ]; then
    echo "Would store a new deploy token for the Fly app $app in the Keychain item $item."
    continue
  fi
  token=$(fly tokens create deploy --app "$app" --expiry 8760h) || fail "could not make a deploy token for $app"
  token=$(printf '%s' "$token" | tr -d '\r\n')
  [ -n "$token" ] || fail "fly printed no deploy token for $app"
  printf '%s' "$token" | store "$item" "a new deploy token for the Fly app $app"
  token=""
done

status=0

# Only the item's attributes are read: without -w or -g, security does not
# print the value.
if ! security find-generic-password -s "$match_password_item" >/dev/null 2>&1; then
  echo "The Keychain has no item $match_password_item for MATCH_PASSWORD. Add the match repository's passphrase with:" >&2
  echo "  security add-generic-password -U -a templatr -s $match_password_item -w" >&2
  echo "which asks for the value, so that it is not in the shell history." >&2
  status=1
fi
if ! security find-generic-password -s "$match_key_item" >/dev/null 2>&1; then
  echo "The Keychain has no item $match_key_item for MATCH_DEPLOY_KEY. Run templatr bootstrap on an apple-app project, which makes the key and stores it with its public half in $match_key_item.pub, then add the public half to the match repository as a read-only deploy key." >&2
  status=1
fi

# Each repository is checked, even after one that has something left to do.
printf '%s' "$checks" | {
  failed=0
  while IFS= read -r repository; do
    if [ "$dry_run" -eq 1 ]; then
      echo "Would run templatr check on $repository."
      continue
    fi
    echo "templatr check $repository"
    swift run --package-path "$root" templatr check "$repository" || failed=1
  done
  exit $failed
} || status=1

exit $status
