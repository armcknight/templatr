#!/bin/sh
# Usage: check-supabase-project <project-ref>
#
# Exits 0 when the Supabase CLI, logged in with `supabase login` or with
# SUPABASE_ACCESS_TOKEN in the environment, can see the project. It prints the
# project's name and region.

ref="$1"

if [ -z "$ref" ]; then
  echo "Usage: check-supabase-project <project-ref>" >&2
  exit 2
fi

if ! projects=$(supabase projects list --output json 2>/dev/null); then
  echo "The Supabase CLI could not list the projects. Run supabase login." >&2
  exit 1
fi

# Newer CLIs name the reference ID `ref`, older ones `id`.
if ! project=$(printf '%s' "$projects" | jq -ce --arg ref "$ref" 'first(.[] | select(.ref == $ref or .id == $ref))'); then
  echo "The Supabase CLI cannot see the project $ref." >&2
  exit 1
fi

printf '%s\n' "$project" | jq -r '"\(.name) (\(.ref // .id)), in \(.region)"'
