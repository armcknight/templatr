#!/usr/bin/env swift
// Usage: list-match-certificates <match git URL> [<bundle IDs, comma separated>...]
//
// Prints one line for each certificate in the fastlane match repository, and
// for each provisioning profile there for one of the bundle IDs (every profile
// when none is given): its expiry as an ISO 8601 date and time, a tab, and its
// name. Exits 2 when it cannot read the repository.
//
// It clones the repository's default branch into a temporary directory and
// decrypts each file in memory, with MATCH_PASSWORD or, without it, the
// Keychain item superlinear.match.password. Nothing decrypted is written to a
// file. It decrypts as fastlane's Match::Encryption::MatchDataEncryption does,
// both versions, so it needs neither Ruby nor fastlane.

import CommonCrypto
import CryptoKit
import Foundation
import Security

func fail(_ message: String) -> Never {
    FileHandle.standardError.write(Data((message + "\n").utf8))
    exit(2)
}

/// Runs a command and returns its exit status, standard output and standard
/// error.
func run(_ arguments: [String]) -> (status: Int32, output: String, error: String) {
    let process = Process()
    process.executableURL = URL(fileURLWithPath: "/usr/bin/env")
    process.arguments = arguments
    let output = Pipe()
    let error = Pipe()
    process.standardOutput = output
    process.standardError = error
    do {
        try process.run()
    } catch {
        fail("Could not run \(arguments[0]): \(error.localizedDescription)")
    }
    let outputData = output.fileHandleForReading.readDataToEndOfFile()
    let errorData = error.fileHandleForReading.readDataToEndOfFile()
    process.waitUntilExit()
    return (process.terminationStatus, String(decoding: outputData, as: UTF8.self), String(decoding: errorData, as: UTF8.self))
}

// MARK: Decryption

enum DecryptionError: Error {
    case malformed
    case wrongPassword
}

enum Digest {
    case md5, sha256
}

/// OpenSSL's EVP_BytesToKey with one iteration, which Ruby's
/// `Cipher#pkcs5_keyivgen` is: each block is the digest of the one before, the
/// password and the salt.
func bytesToKey(password: Data, salt: Data, digest: Digest, length: Int) -> Data {
    var result = Data()
    var block = Data()
    while result.count < length {
        let input = block + password + salt
        switch digest {
        case .md5: block = Data(Insecure.MD5.hash(data: input))
        case .sha256: block = Data(SHA256.hash(data: input))
        }
        result += block
    }
    return result.prefix(length)
}

/// Version 1: AES-256-CBC, with the key and IV from EVP_BytesToKey.
func decryptV1(_ data: Data, password: Data, salt: Data, digest: Digest) throws -> Data {
    let keyIV = bytesToKey(password: password, salt: salt, digest: digest, length: kCCKeySizeAES256 + kCCBlockSizeAES128)
    let key = keyIV.prefix(kCCKeySizeAES256)
    let iv = keyIV.suffix(kCCBlockSizeAES128)
    var output = Data(count: data.count + kCCBlockSizeAES128)
    var written = 0
    let outputCount = output.count
    let status = output.withUnsafeMutableBytes { outputBytes in
        data.withUnsafeBytes { dataBytes in
            key.withUnsafeBytes { keyBytes in
                iv.withUnsafeBytes { ivBytes in
                    CCCrypt(
                        CCOperation(kCCDecrypt), CCAlgorithm(kCCAlgorithmAES), CCOptions(kCCOptionPKCS7Padding),
                        keyBytes.baseAddress, key.count, ivBytes.baseAddress,
                        dataBytes.baseAddress, data.count,
                        outputBytes.baseAddress, outputCount, &written
                    )
                }
            }
        }
    }
    guard status == kCCSuccess else { throw DecryptionError.wrongPassword }
    return output.prefix(written)
}

/// Version 2: AES-256-GCM, with the key, the IV and the authenticated data
/// from PBKDF2-HMAC-SHA256.
func decryptV2(_ data: Data, password: Data, salt: Data, tag: Data) throws -> Data {
    var keyIV = Data(count: 32 + 12 + 24)
    let keyIVCount = keyIV.count
    let status = keyIV.withUnsafeMutableBytes { keyIVBytes in
        salt.withUnsafeBytes { saltBytes in
            password.withUnsafeBytes { passwordBytes in
                CCKeyDerivationPBKDF(
                    CCPBKDFAlgorithm(kCCPBKDF2),
                    passwordBytes.bindMemory(to: CChar.self).baseAddress, password.count,
                    saltBytes.bindMemory(to: UInt8.self).baseAddress, salt.count,
                    CCPseudoRandomAlgorithm(kCCPRFHmacAlgSHA256), 10_000,
                    keyIVBytes.bindMemory(to: UInt8.self).baseAddress, keyIVCount
                )
            }
        }
    }
    guard status == kCCSuccess else { throw DecryptionError.malformed }
    let key = SymmetricKey(data: keyIV.prefix(32))
    let box = try AES.GCM.SealedBox(nonce: AES.GCM.Nonce(data: keyIV.subdata(in: 32..<44)), ciphertext: data, tag: tag)
    do {
        return try AES.GCM.open(box, using: key, authenticating: keyIV.subdata(in: 44..<68))
    } catch {
        throw DecryptionError.wrongPassword
    }
}

/// Decrypts a file of the match repository: base64 of a prefix, an 8-byte salt,
/// for version 2 a 16-byte tag, and the encrypted data. It returns each data
/// that the file decrypts to, to read in turn: version 1 has no integrity
/// check, so data that decrypts with the wrong digest can be garbage.
func decrypt(_ contents: Data, password: String) throws -> [Data] {
    guard let stored = Data(base64Encoded: contents, options: .ignoreUnknownCharacters) else { throw DecryptionError.malformed }
    let password = Data(password.utf8)
    let v2Prefix = Data("match_encrypted_v2__".utf8)
    if stored.starts(with: v2Prefix) {
        let start = stored.startIndex + v2Prefix.count
        guard stored.count >= v2Prefix.count + 8 + 16 else { throw DecryptionError.malformed }
        let salt = stored.subdata(in: start..<start + 8)
        let tag = stored.subdata(in: start + 8..<start + 24)
        return [try decryptV2(stored.subdata(in: start + 24..<stored.endIndex), password: password, salt: salt, tag: tag)]
    }
    guard stored.count >= 16 else { throw DecryptionError.malformed }
    let salt = stored.subdata(in: stored.startIndex + 8..<stored.startIndex + 16)
    let encrypted = stored.subdata(in: stored.startIndex + 16..<stored.endIndex)
    // OpenSSL 1.0 used MD5, and 1.1 and later SHA-256; fastlane tries both.
    let candidates = [Digest.md5, .sha256].compactMap { try? decryptV1(encrypted, password: password, salt: salt, digest: $0) }
    guard !candidates.isEmpty else { throw DecryptionError.wrongPassword }
    return candidates
}

// MARK: Reading

/// A certificate's expiry and common name.
func readCertificate(_ data: Data) -> (expires: Date, name: String?)? {
    guard let certificate = SecCertificateCreateWithData(nil, data as CFData),
          let values = SecCertificateCopyValues(certificate, [kSecOIDX509V1ValidityNotAfter] as CFArray, nil) as? [CFString: Any],
          let notAfter = values[kSecOIDX509V1ValidityNotAfter] as? [CFString: Any],
          let seconds = notAfter[kSecPropertyKeyValue] as? NSNumber
    else { return nil }
    var commonName: CFString?
    SecCertificateCopyCommonName(certificate, &commonName)
    return (Date(timeIntervalSinceReferenceDate: seconds.doubleValue), commonName as String?)
}

/// A profile's property list, the content of its CMS message. As fastlane
/// reads a profile, the signature is not what this checks.
func readProfile(_ data: Data) -> [String: Any]? {
    var decoder: CMSDecoder?
    guard CMSDecoderCreate(&decoder) == errSecSuccess, let decoder else { return nil }
    let status = data.withUnsafeBytes { bytes in
        CMSDecoderUpdateMessage(decoder, bytes.baseAddress!, data.count)
    }
    var content: CFData?
    guard status == errSecSuccess,
          CMSDecoderFinalizeMessage(decoder) == errSecSuccess,
          CMSDecoderCopyContent(decoder, &content) == errSecSuccess,
          let content
    else { return nil }
    return (try? PropertyListSerialization.propertyList(from: content as Data, format: nil)) as? [String: Any]
}

/// The files under a directory of the clone whose extensions are one of these,
/// sorted by path.
func files(in directory: URL, extensions: Set<String>) -> [URL] {
    guard let enumerator = FileManager.default.enumerator(at: directory, includingPropertiesForKeys: nil) else { return [] }
    return enumerator.compactMap { $0 as? URL }
        .filter { extensions.contains($0.pathExtension) }
        .sorted { $0.path < $1.path }
}

// MARK: Main

let arguments = Array(CommandLine.arguments.dropFirst())
guard let gitURL = arguments.first, !gitURL.isEmpty else {
    FileHandle.standardError.write(Data("Usage: list-match-certificates <match git URL> [<bundle IDs, comma separated>...]\n".utf8))
    exit(1)
}
let bundleIDs = Set(arguments.dropFirst()
    .flatMap { $0.split(separator: ",") }
    .map { $0.trimmingCharacters(in: .whitespaces) }
    .filter { !$0.isEmpty })

var password = ProcessInfo.processInfo.environment["MATCH_PASSWORD"] ?? ""
if password.isEmpty {
    let keychain = run(["security", "find-generic-password", "-s", "superlinear.match.password", "-w"])
    password = keychain.output.trimmingCharacters(in: .newlines)
    if keychain.status != 0 || password.isEmpty {
        fail("MATCH_PASSWORD is not set, and the Keychain has no item superlinear.match.password.")
    }
}

let directory = FileManager.default.temporaryDirectory.appending(path: "match-\(UUID().uuidString)")
let clone = run(["git", "clone", "--quiet", "--depth", "1", gitURL, directory.path])
if clone.status != 0 {
    try? FileManager.default.removeItem(at: directory)
    fail("Could not clone \(gitURL): \(clone.error.trimmingCharacters(in: .whitespacesAndNewlines))")
}

/// The path of a file in the clone, for messages.
func relative(_ file: URL) -> String {
    String(file.standardizedFileURL.path.dropFirst(directory.standardizedFileURL.path.count + 1))
}

/// Fails, after removing the clone.
func failReading(_ message: String) -> Never {
    try? FileManager.default.removeItem(at: directory)
    fail(message)
}

/// The first value that `read` reads from what the file decrypts to.
func read<Value>(_ file: URL, _ read: (Data) -> Value?) -> Value? {
    guard let contents = try? Data(contentsOf: file) else { failReading("Could not read \(relative(file)).") }
    do {
        return try decrypt(contents, password: password).lazy.compactMap(read).first
    } catch {
        failReading("Could not decrypt \(relative(file)). Is MATCH_PASSWORD right?")
    }
}

var lines: [(expires: Date, name: String)] = []

for file in files(in: directory.appending(path: "certs"), extensions: ["cer"]) {
    guard let certificate = read(file, readCertificate) else {
        failReading("Could not read the certificate \(relative(file)). Is MATCH_PASSWORD right?")
    }
    lines.append((certificate.expires, "certificate \(certificate.name ?? file.deletingPathExtension().lastPathComponent)"))
}

for file in files(in: directory.appending(path: "profiles"), extensions: ["mobileprovision", "provisionprofile"]) {
    let profile = read(file) { data in
        readProfile(data).flatMap { profile in profile["ExpirationDate"] is Date ? profile : nil }
    }
    guard let profile, let expires = profile["ExpirationDate"] as? Date else {
        failReading("Could not read the profile \(relative(file)). Is MATCH_PASSWORD right?")
    }
    // The application identifier is the team ID, a dot, and the bundle ID.
    let entitlements = profile["Entitlements"] as? [String: Any]
    let applicationIdentifier = entitlements?["application-identifier"] as? String ?? ""
    let bundleID = applicationIdentifier.split(separator: ".", maxSplits: 1).last.map(String.init) ?? ""
    guard bundleIDs.isEmpty || bundleIDs.contains(bundleID) else { continue }
    lines.append((expires, "profile \(profile["Name"] as? String ?? file.lastPathComponent)"))
}

try? FileManager.default.removeItem(at: directory)

let formatter = ISO8601DateFormatter()
for line in lines.sorted(by: { $0.expires < $1.expires }) {
    print("\(formatter.string(from: line.expires))\t\(line.name)")
}
