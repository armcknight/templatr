#!/bin/sh
# Usage: check-secrets-inherit [<workflows directory>]
#
# Exits 0 when each job in the workflows, .github/workflows by default, that
# calls a workflow in armcknight/workflows passes it the caller's secrets, with
# `secrets: inherit` or with a `SITE_DISPATCH_TOKEN` under its `secrets`, so
# that the shared workflows' notify step gets the token. It exits 1, and names
# each job that does not, or when no job calls armcknight/workflows: then
# nothing asks mcknight.io to refresh.

dir="${1:-.github/workflows}"

set -- "$dir"/*.yml "$dir"/*.yaml
files=""
for file in "$@"; do
  [ -f "$file" ] && files="$files$file
"
done

if [ -z "$files" ]; then
  echo "$dir has no workflows, so no job calls armcknight/workflows." >&2
  exit 1
fi

# For each job under the top-level `jobs:`, prints `call <file> <job>` when it
# calls a workflow in armcknight/workflows, and `missing <file> <job>` when it
# also passes no secrets to it. A job's key is the first key indented under
# `jobs:`, and every key at that indentation starts another job; `secrets` is
# read only at the indentation of the job's first key, not under `with`.
result=$(printf '%s' "$files" | while IFS= read -r file; do
  awk -v file="$file" '
    function finish() {
      if (job != "" && calls) {
        print "call " file " " job
        if (!passes) print "missing " file " " job
      }
      job = ""; calls = 0; passes = 0; insecrets = 0; keyindent = -1
    }
    /^[[:space:]]*(#|$)/ { next }
    {
      match($0, /^ */); indent = RLENGTH
    }
    indent == 0 {
      finish()
      injobs = ($0 ~ /^jobs:[[:space:]]*(#.*)?$/)
      jobindent = -1
      next
    }
    !injobs { next }
    jobindent < 0 { jobindent = indent }
    indent == jobindent {
      finish()
      job = $0; sub(/^ */, "", job); sub(/:.*/, "", job)
      next
    }
    indent < jobindent { next }
    keyindent < 0 { keyindent = indent }
    /^[[:space:]]*uses:[[:space:]]*["\x27]?armcknight\/workflows\/\.github\/workflows\// { calls = 1 }
    insecrets && indent <= keyindent { insecrets = 0 }
    indent == keyindent && /^[[:space:]]*secrets:[[:space:]]*inherit[[:space:]]*(#.*)?$/ { passes = 1 }
    indent == keyindent && /^[[:space:]]*secrets:[[:space:]]*(#.*)?$/ { insecrets = 1; next }
    insecrets && /^[[:space:]]*SITE_DISPATCH_TOKEN:/ { passes = 1 }
    END { finish() }
  ' "$file"
done)

if ! printf '%s\n' "$result" | grep -q '^call '; then
  echo "No job in $dir calls a workflow in armcknight/workflows, so nothing asks mcknight.io to refresh." >&2
  exit 1
fi

missing=$(printf '%s\n' "$result" | sed -n 's/^missing \(.*\) \(.*\)$/\1: job \2 calls armcknight\/workflows without secrets: inherit./p')
if [ -n "$missing" ]; then
  printf '%s\n' "$missing" >&2
  exit 1
fi
