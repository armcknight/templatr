#!/bin/sh
# Usage: check-fly-secrets <app> [<names>]
#
# Exits 0 when the Fly app has a secret with each name. <names> is one argument
# of names separated by spaces, or several arguments; with none, there is
# nothing to check. Only the names are read: `fly secrets list` never prints a
# value.

app="$1"

if [ -z "$app" ]; then
  echo "Usage: check-fly-secrets <app> [<names>]" >&2
  exit 2
fi
shift

# Each argument can hold several names.
# shellcheck disable=SC2048,SC2086
set -- $*
if [ $# -eq 0 ]; then
  exit 0
fi

if ! names=$(fly secrets list --app "$app" --json | jq -r '.[] | .name // .Name'); then
  echo "Could not list the secrets of $app." >&2
  exit 1
fi

status=0
for name in "$@"; do
  if ! printf '%s\n' "$names" | grep -qx "$name"; then
    echo "$app has no secret $name." >&2
    status=1
  fi
done
exit $status
