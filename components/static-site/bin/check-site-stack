#!/bin/sh
# Usage: check-site-stack <domain> <profile> <with-www> <price-class> <template>
#
# Exits 0 when the CloudFormation stack for <domain>, site-<domain with dashes>
# in us-east-1, is complete, was made from <template>, the static-site
# component's cloudformation/site.yml as site-template renders it with
# viewer-request.js, and has the WithWww and PriceClass parameters given.
# Read-only: it describes and gets, and changes nothing. Each problem is
# printed to stderr. deploy-site-stack, with the same arguments, puts the stack
# right.

domain=${1:-}
profile=${2:-}
with_www=${3:-}
price_class=${4:-}
template=${5:-}

if [ -z "$domain" ] || [ -z "$profile" ] || [ -z "$with_www" ] || [ -z "$price_class" ] || [ -z "$template" ]; then
  echo "Usage: check-site-stack <domain> <profile> <with-www> <price-class> <template>" >&2
  exit 2
fi
if [ ! -f "$template" ]; then
  echo "The template, $template, does not exist." >&2
  exit 1
fi

stack="site-$(printf '%s' "$domain" | tr . -)"

rendered=$(mktemp)
trap 'rm -f "$rendered"' EXIT
"$(dirname "$0")/site-template" "$template" > "$rendered" || exit 1

aws_get() {
  aws "$@" --output text --profile "$profile" --region us-east-1 --no-cli-pager
}

if ! description=$(aws_get cloudformation describe-stacks --stack-name "$stack" \
    --query 'Stacks[0].[StackStatus, Parameters[?ParameterKey==`DomainName`].ParameterValue | [0], Parameters[?ParameterKey==`WithWww`].ParameterValue | [0], Parameters[?ParameterKey==`PriceClass`].ParameterValue | [0]]' 2>&1); then
  echo "No stack $stack in us-east-1 for profile $profile: $description" >&2
  exit 1
fi
status=$(printf '%s' "$description" | cut -f1)
stack_domain=$(printf '%s' "$description" | cut -f2)
stack_www=$(printf '%s' "$description" | cut -f3)
stack_price=$(printf '%s' "$description" | cut -f4)

wrong=0
check() {
  if [ "$2" = "$3" ]; then
    echo "  ok     $1: $3"
  else
    echo "  WRONG  $1: found ${3:-(nothing)}, expected $2" >&2
    wrong=$((wrong + 1))
  fi
}

case $status in
  CREATE_COMPLETE|UPDATE_COMPLETE) echo "  ok     status: $status" ;;
  *) echo "  WRONG  status: $status, expected CREATE_COMPLETE or UPDATE_COMPLETE" >&2; wrong=$((wrong + 1)) ;;
esac
check "DomainName" "$domain" "$stack_domain"
check "WithWww" "$with_www" "$stack_www"
check "PriceClass" "$price_class" "$stack_price"

# The stack's template, as it was given: the same text as the file when the
# stack was made from this version of it.
if deployed=$(aws_get cloudformation get-template --stack-name "$stack" --template-stage Original --query TemplateBody 2>&1); then
  if [ "$(printf '%s' "$deployed" | sed -e 's/[[:space:]]*$//')" = "$(sed -e 's/[[:space:]]*$//' "$rendered")" ]; then
    echo "  ok     template: $(basename "$template") with viewer-request.js"
  else
    echo "  WRONG  template: the stack was not made from the current $(basename "$template") and viewer-request.js; run deploy-site-stack to update it" >&2
    wrong=$((wrong + 1))
  fi
else
  echo "  WRONG  template: could not read the stack's template: $deployed" >&2
  wrong=$((wrong + 1))
fi

[ "$wrong" -eq 0 ]
