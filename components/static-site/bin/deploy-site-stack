#!/bin/sh
# Usage: deploy-site-stack <domain> <profile> <with-www> <price-class> <template>
#
# Makes or updates the CloudFormation stack that hosts the site at <domain>:
# the private bucket, the certificate, the distribution and the DNS records
# that <template>, the static-site component's cloudformation/site.yml,
# describes, with viewer-request.js next to it put in by site-template. The
# stack is named for the domain, site-travel-mcknight-io for
# travel.mcknight.io, and is in us-east-1, where CloudFront needs the
# certificate. It can be run again: a stack that is already as the template
# says is left as it is.
#
# <with-www> is true or false: whether www.<domain> is on the certificate and
# redirects to <domain>. <price-class> is PriceClass_100, PriceClass_200 or
# PriceClass_All.
#
# The first run waits for the certificate and the distribution: 5 to 20
# minutes. The static-site component's hosting-stack step runs it, and so does
# `make site stack`.

set -eu

domain=${1:-}
profile=${2:-}
with_www=${3:-}
price_class=${4:-}
template=${5:-}

if [ -z "$domain" ] || [ -z "$profile" ] || [ -z "$with_www" ] || [ -z "$price_class" ] || [ -z "$template" ]; then
  echo "Usage: deploy-site-stack <domain> <profile> <with-www> <price-class> <template>" >&2
  exit 2
fi
if [ ! -f "$template" ]; then
  echo "The template, $template, does not exist." >&2
  exit 1
fi

stack="site-$(printf '%s' "$domain" | tr . -)"
zone=$("$(dirname "$0")/site-zone" "$domain" "$profile")

rendered=$(mktemp)
trap 'rm -f "$rendered"' EXIT
"$(dirname "$0")/site-template" "$template" > "$rendered"

echo "Deploying the stack $stack for $domain, in the hosted zone $zone, with profile $profile."
echo "A new stack waits for the certificate and the distribution: 5 to 20 minutes."
aws cloudformation deploy \
  --stack-name "$stack" \
  --template-file "$rendered" \
  --parameter-overrides "DomainName=$domain" "HostedZoneId=$zone" "WithWww=$with_www" "PriceClass=$price_class" \
  --no-fail-on-empty-changeset \
  --profile "$profile" --region us-east-1 --no-cli-pager

aws cloudformation describe-stacks --stack-name "$stack" \
  --query 'Stacks[0].Outputs[].[OutputKey,OutputValue]' --output table \
  --profile "$profile" --region us-east-1 --no-cli-pager
