#!/bin/sh
# Usage: site-template <template>
#
# Prints one of the static-site component's CloudFormation templates, <template>,
# with each `@FUNCTION <file>@` line replaced by that file, next to the
# template, indented as the line was: site.yml takes viewer-request.js, and
# redirect.yml takes redirect.js. CloudFormation has no include of its own, so
# each function is kept in a file of its own, where it can be read and run,
# and put into the template here. deploy-stack deploys what this prints, and
# check-stack compares the stack with it.

template=${1:-}

if [ -z "$template" ]; then
  echo "Usage: site-template <template>" >&2
  exit 2
fi
if [ ! -f "$template" ]; then
  echo "The template, $template, does not exist." >&2
  exit 1
fi
directory=$(dirname "$template")

for file in $(sed -n 's/^[[:space:]]*@FUNCTION \([^@]*\)@[[:space:]]*$/\1/p' "$template"); do
  if [ ! -f "$directory/$file" ]; then
    echo "The function, $directory/$file, does not exist." >&2
    exit 1
  fi
done

awk -v directory="$directory" '
  /^[[:space:]]*@FUNCTION [^@]*@[[:space:]]*$/ {
    match($0, /^[[:space:]]*/)
    indent = substr($0, 1, RLENGTH)
    file = $0
    sub(/^[[:space:]]*@FUNCTION /, "", file)
    sub(/@[[:space:]]*$/, "", file)
    path = directory "/" file
    while ((getline line < path) > 0) {
      print (line == "" ? "" : indent line)
    }
    close(path)
    next
  }
  { print }
' "$template"
