# The apple-app component's shared lanes. A project imports them at a tag:
#
#   ENV["APPLE_APP_SCHEME"] ||= "Babysittr"
#   ...
#   import_from_git(url: "https://github.com/armcknight/templates.git", branch: "v1", path: "fastlane/Fastfile")
#
# and runs `fastlane ios test`, `fastlane ios stage` and `fastlane ios beta`.
# tvos and mac have test and beta. Each setting is read from a lane option
# first, then from its APPLE_APP_* environment variable; see
# APPLE_APP_SETTINGS. The project must not define a test, stage or beta lane
# of its own, as fastlane rejects a lane defined twice.
#
# test runs on each pull request, in armcknight/workflows' ios-ci.yml. stage
# builds an ad-hoc IPA, <app name>-staging.ipa, for a staging build that a
# `/build-staging` comment asks for. ios-ci.yml sets MATCH_PASSWORD and gives
# read access to the match repository through the MATCH_DEPLOY_KEY secret.
#
# beta uploads to TestFlight. Only the owner runs it, by hand, through
# `make deploy-beta`, after prepare-release has set the build number in the
# xcconfig and tagged the commit. It signs in to App Store Connect with an API
# key when ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_P8_BASE64 are set, which
# needs no two-factor prompt, and with fastlane's usual sign-in when not.

require "open3"

# Option name => [environment variable, default]. A nil default means required.
APPLE_APP_SETTINGS = {
  scheme: ["APPLE_APP_SCHEME", nil],
  project: ["APPLE_APP_PROJECT", ""],
  workspace: ["APPLE_APP_WORKSPACE", ""],
  app_name: ["APPLE_APP_NAME", ""],
  bundle_id: ["APPLE_APP_BUNDLE_ID", nil],
  adhoc_bundle_id: ["APPLE_APP_ADHOC_BUNDLE_ID", ""],
  app_identifiers: ["APPLE_APP_IDENTIFIERS", ""],
  team_id: ["APPLE_APP_TEAM_ID", ""],
  match_git_url: ["APPLE_APP_MATCH_GIT_URL", ""],
  test_device: ["APPLE_APP_TEST_DEVICE", "iPhone 16 Pro"],
  test_configuration: ["APPLE_APP_TEST_CONFIGURATION", "Debug"],
  stage_configuration: ["APPLE_APP_STAGE_CONFIGURATION", "Release"],
  stage_xcargs: ["APPLE_APP_STAGE_XCARGS", ""],
  beta_configuration: ["APPLE_APP_BETA_CONFIGURATION", "Release"],
  changelog: ["APPLE_APP_CHANGELOG", "../CHANGELOG.md"]
}.freeze

# fastlane's platform => the name match uses for it.
APPLE_APP_MATCH_PLATFORMS = { ios: "ios", tvos: "tvos", mac: "macos" }.freeze

# fastlane's platform => the name App Store Connect uses for it.
APPLE_APP_ASC_PLATFORMS = { ios: "ios", tvos: "appletvos", mac: "osx" }.freeze

# TestFlight rejects a "What to Test" text longer than this.
APPLE_APP_WHAT_TO_TEST_LIMIT = 4000

def apple_app_settings(options)
  APPLE_APP_SETTINGS.to_h do |key, (variable, default)|
    value = options[key]&.to_s
    value = ENV.fetch(variable, "") if value.nil? || value.empty?
    value = default if value.empty?
    UI.user_error!("Set #{variable}, or pass #{key}: to the lane.") if value.nil?
    [key, value]
  end
end

# A setting that one lane needs, though the others do not.
def apple_app_require(settings, key, lane)
  return settings[key] unless settings[key].empty?

  UI.user_error!("The #{lane} lane needs #{APPLE_APP_SETTINGS[key][0]}, or #{key}: passed to the lane.")
end

# The project or the workspace, as the build and test actions take them.
def apple_app_container(settings)
  return { workspace: settings[:workspace] } unless settings[:workspace].empty?
  return { project: settings[:project] } unless settings[:project].empty?

  {}
end

def apple_app_identifiers(settings)
  identifiers = settings[:app_identifiers].split(",").map(&:strip).reject(&:empty?)
  identifiers.empty? ? [settings[:bundle_id]] : identifiers
end

# Fetches the certificates and profiles, read-only: lanes never change them.
def apple_app_match(settings, platform, type, identifiers)
  parameters = {
    type: type,
    readonly: true,
    app_identifier: identifiers,
    platform: APPLE_APP_MATCH_PLATFORMS.fetch(platform)
  }
  parameters[:git_url] = settings[:match_git_url] unless settings[:match_git_url].empty?
  parameters[:team_id] = settings[:team_id] unless settings[:team_id].empty?
  # A Mac App Store upload is a .pkg, signed with the installer certificate.
  parameters[:additional_cert_types] = ["mac_installer_distribution"] if platform == :mac && type == "appstore"
  match(**parameters)
end

# The "What to Test" text: the CHANGELOG.md entry for the latest tag, which
# prepare-release has just made from the Unreleased section. Lanes run in
# fastlane/, so the default path is ../CHANGELOG.md.
def apple_app_what_to_test(settings)
  # Not fastlane's sh, which mixes standard error into the output it returns.
  text, status = Open3.capture2("read-changelog", settings[:changelog], "--latest-tag")
  UI.user_error!("read-changelog found no entry for the latest tag in #{settings[:changelog]}.") unless status.success?

  text = text.strip
  return text if text.length <= APPLE_APP_WHAT_TO_TEST_LIMIT

  "#{text[0, APPLE_APP_WHAT_TO_TEST_LIMIT - 2]}\n…"
rescue Errno::ENOENT
  UI.user_error!("read-changelog is not installed. It is in the armcknight/tools cask; run `brew bundle`.")
end

def apple_app_test(platform, options)
  settings = apple_app_settings(options)

  xcargs = "CODE_SIGNING_ALLOWED=NO ONLY_ACTIVE_ARCH=YES"
  if ENV["CI"]
    xcargs += " GCC_PREPROCESSOR_DEFINITIONS='$(inherited) CI=1' SWIFT_ACTIVE_COMPILATION_CONDITIONS='$(inherited) CI'"
  end

  parameters = {
    scheme: settings[:scheme],
    output_types: "junit",
    output_files: "junit.xml",
    code_coverage: true,
    result_bundle: true,
    configuration: settings[:test_configuration],
    xcargs: xcargs
  }.merge(apple_app_container(settings))

  if platform == :mac
    parameters[:destination] = "platform=macOS"
  else
    parameters[:devices] = [settings[:test_device]]
  end

  run_tests(**parameters)
end

def apple_app_stage(options)
  settings = apple_app_settings(options)
  app_name = apple_app_require(settings, :app_name, "stage")
  adhoc_bundle_id = apple_app_require(settings, :adhoc_bundle_id, "stage")

  setup_ci if ENV["CI"]
  apple_app_match(settings, :ios, "adhoc", [adhoc_bundle_id])

  export_options = {
    method: "ad-hoc",
    signingStyle: "manual",
    # Set explicitly: gym's own guess can pick another target's App Store
    # profile and then stop on an export method mismatch. Only the app's
    # bundle ID needs a profile; embedded frameworks are signed with the
    # distribution certificate.
    provisioningProfiles: { adhoc_bundle_id => "match AdHoc #{adhoc_bundle_id}" }
  }
  export_options[:teamID] = settings[:team_id] unless settings[:team_id].empty?

  parameters = {
    **apple_app_container(settings),
    scheme: settings[:scheme],
    configuration: settings[:stage_configuration],
    export_method: "ad-hoc",
    clean: true,
    xcodebuild_formatter: "xcbeautify",
    # ios-ci.yml's ipa-name input must be this name.
    output_name: "#{app_name}-staging",
    export_options: export_options
  }
  # Such as a build setting that switches the app to its ad-hoc bundle ID.
  parameters[:xcargs] = settings[:stage_xcargs] unless settings[:stage_xcargs].empty?

  build_app(**parameters)
end

def apple_app_beta(platform, options)
  settings = apple_app_settings(options)

  if %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8_BASE64].all? { |name| !ENV.fetch(name, "").empty? }
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  apple_app_match(settings, platform, "appstore", apple_app_identifiers(settings))

  what_to_test = apple_app_what_to_test(settings)

  # The build number is CURRENT_PROJECT_VERSION in the xcconfig, which
  # prepare-release has just raised. CFBundleVersion must be
  # $(CURRENT_PROJECT_VERSION) in each Info.plist, an embedded watch app's too.
  build_app(
    **apple_app_container(settings),
    scheme: settings[:scheme],
    configuration: settings[:beta_configuration],
    export_method: "app-store",
    clean: true,
    xcodebuild_formatter: "xcbeautify",
    export_xcargs: "-allowProvisioningUpdates"
  )

  # Without waiting for processing, TestFlight cannot distribute to a group
  # here; the internal group's automatic distribution does that.
  upload_to_testflight(
    app_identifier: settings[:bundle_id],
    app_platform: APPLE_APP_ASC_PLATFORMS.fetch(platform),
    changelog: what_to_test,
    skip_waiting_for_build_processing: true,
    skip_submission: true
  )
end

platform :ios do
  desc "Run the tests on a simulator"
  lane(:test) { |options| apple_app_test(:ios, options) }

  desc "Build an ad-hoc IPA, <app name>-staging.ipa, for a staging build"
  lane(:stage) { |options| apple_app_stage(options) }

  desc "Build and upload to TestFlight. Run by `make deploy-beta`, after prepare-release"
  lane(:beta) { |options| apple_app_beta(:ios, options) }
end

platform :tvos do
  desc "Run the tests on a simulator"
  lane(:test) { |options| apple_app_test(:tvos, options) }

  desc "Build and upload to TestFlight. Run by `make deploy-beta`, after prepare-release"
  lane(:beta) { |options| apple_app_beta(:tvos, options) }
end

platform :mac do
  desc "Run the tests on this Mac"
  lane(:test) { |options| apple_app_test(:mac, options) }

  desc "Build and upload to TestFlight. Run by `make deploy-beta`, after prepare-release"
  lane(:beta) { |options| apple_app_beta(:mac, options) }
end
