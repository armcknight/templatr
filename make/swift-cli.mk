# The swift-cli component's Makefile targets, for a command line tool built
# with the Swift Package Manager whose Package.swift is at the repository's
# root. A project's cli/component.mk includes this file, downloaded at its
# pinned tag, and maps `make cli <command>` to them; the root Makefile includes
# cli/component.mk. The targets are namespaced so that the project's own
# targets can depend on them, or do more. They run from the repository's root.
#
# Set these before the include:
#
#   SWIFT_CLI_NAME                  the tool's executable, whose --version `swift-cli-install` prints
#   SWIFT_CLI_BINARIES              the executables `swift-cli-install` copies, separated by spaces
#   SWIFT_CLI_VERSION_FILE          the Swift file with the version that vrsn bumps
#   SWIFT_CLI_VRSN_KEY              the name of the version on that line, for `vrsn -k`
#   SWIFT_CLI_DISTRIBUTION          cask, for a tool that ships as a Homebrew cask, or github-release
#   SWIFT_CLI_CASK                  the cask's name in armcknight/homebrew-tools
#   SWIFT_CLI_DIR                   the component's directory, with its Brewfile
#   SWIFT_CLI_DEV_FLAG              the compilation condition of a `swift-cli-install` build
#   SWIFT_CLI_METADATA_FILE         the gitignored file that `swift-cli-install` writes the build metadata in
#   SWIFT_CLI_METADATA_DECLARATION  the declaration in that file, which the tool's own BuildMetadata.swift reads
#   SWIFT_CLI_INSTALL_DIR           where `swift-cli-install` copies the executables
#   SWIFT_CLI_TAPS                  the third-party taps that `swift-cli-init` trusts
#
# vrsn and prepare-release come from the armcknight/tools cask, which the
# component's Brewfile has.

SWIFT_CLI_NAME ?=
SWIFT_CLI_BINARIES ?= $(SWIFT_CLI_NAME)
SWIFT_CLI_VERSION_FILE ?=
SWIFT_CLI_VRSN_KEY ?= version
SWIFT_CLI_DISTRIBUTION ?= cask
SWIFT_CLI_CASK ?= $(SWIFT_CLI_NAME)
SWIFT_CLI_DIR ?= cli
# MYTOOL_DEV_BUILD for mytool, and MY_TOOL_DEV_BUILD for my-tool.
SWIFT_CLI_DEV_FLAG ?= $(shell printf '%s' '$(SWIFT_CLI_NAME)' | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9' '_')_DEV_BUILD
SWIFT_CLI_METADATA_FILE ?= $(dir $(SWIFT_CLI_VERSION_FILE))BuildMetadata.generated.swift
# A global, which a `static let buildMetadata` in an extension of the root
# command hides in a build without SWIFT_CLI_DEV_FLAG. armcknight/tools, whose
# version is in a library, sets `public let toolsBuildMetadata: String?`.
SWIFT_CLI_METADATA_DECLARATION ?= let buildMetadata: String?
# A tool that ships as a cask replaces the cask's link in Homebrew's bin, so
# that the build runs in every shell, and `swift-cli-uninstall` restores it.
# Another goes in ~/.local/bin.
SWIFT_CLI_INSTALL_DIR ?= $(if $(filter cask,$(SWIFT_CLI_DISTRIBUTION)),$(shell brew --prefix)/bin,$(HOME)/.local/bin)
SWIFT_CLI_TAPS ?= armcknight/tools

# The tool's own repository has a GitHub release for each version. A cask's
# release workflow publishes the binary in the tap, so `swift-cli-deploy` makes
# the release here; otherwise the release workflow makes it.
SWIFT_CLI_RELEASE_ARGS = $(if $(filter cask,$(SWIFT_CLI_DISTRIBUTION)),--github-release)

.PHONY: swift-cli-init swift-cli-build swift-cli-test swift-cli-install swift-cli-uninstall \
	swift-cli-patch swift-cli-minor swift-cli-major swift-cli-deploy swift-cli-deploy-beta \
	swift-cli-name swift-cli-version-file

# Homebrew refuses to load formulae and casks from an untrusted tap, and
# `brew bundle` stops at the first one without installing anything, so the
# taps are trusted first. Each command is idempotent.
## swift-cli-init: trust the taps and install the component's Brewfile
swift-cli-init:
	@command -v brew >/dev/null 2>&1 || { echo "Homebrew is required: https://brew.sh" >&2; exit 1; }
	@for tap in $(SWIFT_CLI_TAPS); do brew trust --tap "$$tap" || exit 1; done
	brew bundle --file=$(SWIFT_CLI_DIR)/Brewfile

## swift-cli-build: build the release binaries
swift-cli-build:
	swift build -c release

## swift-cli-test: run the tests
swift-cli-test:
	swift test

# A local build carries semver build metadata, the commit plus `.dirty` when
# the working tree has uncommitted or untracked changes, so `--version` tells it
# apart from a release. The tree is checked before the metadata file is
# written; that file is gitignored, so it would not count anyway. Each binary
# is copied to a new file and moved over the old one, so that a running copy
# is not killed by macOS when it is replaced.
## swift-cli-install: build the release binaries with the commit in the version, and copy them into SWIFT_CLI_INSTALL_DIR
swift-cli-install: swift-cli-name swift-cli-version-file
	@metadata="$$(git rev-parse --short HEAD)$$(test -z "$$(git status --porcelain)" || echo .dirty)"; \
	printf '// Generated by `make cli install`. Do not edit.\n#if %s\n%s = "%s"\n#endif\n' '$(SWIFT_CLI_DEV_FLAG)' '$(SWIFT_CLI_METADATA_DECLARATION)' "$$metadata" > '$(SWIFT_CLI_METADATA_FILE)'
	swift build -c release -Xswiftc -D$(SWIFT_CLI_DEV_FLAG)
	@mkdir -p '$(SWIFT_CLI_INSTALL_DIR)'
	@for binary in $(SWIFT_CLI_BINARIES); do \
		cp ".build/release/$$binary" '$(SWIFT_CLI_INSTALL_DIR)'"/$$binary.new" && \
		mv -f '$(SWIFT_CLI_INSTALL_DIR)'"/$$binary.new" '$(SWIFT_CLI_INSTALL_DIR)'"/$$binary" || exit 1; \
	done
	@first='$(SWIFT_CLI_INSTALL_DIR)/$(firstword $(SWIFT_CLI_BINARIES))'; \
	echo "Installed $$("$$first" --version 2>/dev/null) at $(SWIFT_CLI_INSTALL_DIR): $(SWIFT_CLI_BINARIES)"; \
	found="$$(command -v $(firstword $(SWIFT_CLI_BINARIES)))"; \
	if [ -n "$$found" ] && [ "$$found" != "$$first" ]; then \
		echo "warning: $(firstword $(SWIFT_CLI_BINARIES)) resolves to $$found in this shell. Put $(SWIFT_CLI_INSTALL_DIR) before it in PATH to run this build by name."; \
	fi

# Removing the build from Homebrew's bin removes the cask's link too, so the
# cask is installed again when it is there.
## swift-cli-uninstall: remove the build from SWIFT_CLI_INSTALL_DIR, and restore the cask's binaries
swift-cli-uninstall:
	@for binary in $(SWIFT_CLI_BINARIES); do rm -f '$(SWIFT_CLI_INSTALL_DIR)'"/$$binary"; done
	@if [ '$(SWIFT_CLI_DISTRIBUTION)' != cask ]; then \
		echo "Removed the build from $(SWIFT_CLI_INSTALL_DIR)."; \
	elif brew list --cask '$(SWIFT_CLI_CASK)' >/dev/null 2>&1; then \
		brew reinstall --cask '$(SWIFT_CLI_CASK)'; \
	else \
		echo "Removed the build. There is no cask to restore: brew install --cask armcknight/tools/$(SWIFT_CLI_CASK) installs one."; \
	fi

## swift-cli-patch: bump the patch version (x.y.Z) with vrsn and commit (also: swift-cli-minor, swift-cli-major)
swift-cli-patch: swift-cli-version-file
	vrsn patch -f '$(SWIFT_CLI_VERSION_FILE)' -k '$(SWIFT_CLI_VRSN_KEY)' --commit

swift-cli-minor: swift-cli-version-file
	vrsn minor -f '$(SWIFT_CLI_VERSION_FILE)' -k '$(SWIFT_CLI_VRSN_KEY)' --commit

swift-cli-major: swift-cli-version-file
	vrsn major -f '$(SWIFT_CLI_VERSION_FILE)' -k '$(SWIFT_CLI_VRSN_KEY)' --commit

# prepare-release moves CHANGELOG.md's [Unreleased] section into a dated
# section for the version, commits, tags the commit with the version, such as
# `1.2.0`, and pushes. The tag starts the release workflow.
## swift-cli-deploy: migrate the changelog, tag the version and push; the release workflow does the rest
swift-cli-deploy: swift-cli-version-file
	prepare-release --file '$(SWIFT_CLI_VERSION_FILE)' --key '$(SWIFT_CLI_VRSN_KEY)' --push $(SWIFT_CLI_RELEASE_ARGS)

# prepare-release numbers the candidate from the RC sections at the top of the
# changelog, so running it again makes RC2 without a new bump.
## swift-cli-deploy-beta: same, for a release candidate, such as 1.2.0-RC1
swift-cli-deploy-beta: swift-cli-version-file
	prepare-release rc --file '$(SWIFT_CLI_VERSION_FILE)' --key '$(SWIFT_CLI_VRSN_KEY)' --push $(if $(SWIFT_CLI_RELEASE_ARGS),$(SWIFT_CLI_RELEASE_ARGS) --prerelease)

swift-cli-name:
	@test -n '$(SWIFT_CLI_NAME)' || { echo "Set SWIFT_CLI_NAME to the tool's executable." >&2; exit 1; }

swift-cli-version-file:
	@test -n '$(SWIFT_CLI_VERSION_FILE)' || { echo "Set SWIFT_CLI_VERSION_FILE to the Swift file with the version." >&2; exit 1; }
